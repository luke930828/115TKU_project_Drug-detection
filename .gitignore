.venv/
data/

__pycache__/
*.py[cod]
venv/
.env

data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

models/*.pt
models/*.onnx
runs/

# 各模組（modules/<模組>/app/models/）自己的權重檔，同樣不推上 git，走 Release 下載流程
modules/*/app/models/*.pt
modules/*/app/models/*.onnx
modules/*/app/models/*.pth

.DS_Store
*.log
# Ultralytics 會把預訓練基礎權重自動下載到工作目錄（cwd），常常掉在 repo 根目錄
# 例如 yolo11n.pt / yolo26n.pt。這些不是我們訓練的模型，不要進 git。
/*.pt
/*.onnx
/*.pth
